# --- Add what you need to your .env (values with spaces MUST be quoted) ---

# Show prices in rupees everywhere (the default is USD)
COMMERCE_CURRENCY=INR

# WhatsApp: the storefront chat button + share links need only this number
WHATSAPP_BUSINESS_NUMBER="+91 98765 43210"

# Optional: send WhatsApp messages from the admin (Meta WhatsApp Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_AUTO_NOTIFY=false

# Online payments: fill in whichever you use
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox   # change to "live" when going live
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# AR and virtual try-on need no keys. Set them per product in Admin > Products.
