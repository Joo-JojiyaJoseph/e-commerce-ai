{
    "name": "webfolks/commerce-core",
    "description": "Reusable Laravel e-commerce core: cart, checkout, orders, and payment/shipping contracts.",
    "type": "library",
    "license": "proprietary",
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Webfolks\\CommerceCore\\": "src/",
            "Webfolks\\CommerceCore\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webfolks\\CommerceCore\\CommerceCoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
